bughunting.d3vn0mi.com {
    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-XSS-Protection "1; mode=block"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'"
        -Server
    }

    # API requests → backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Everything else → frontend (nginx serving static files)
    handle {
        reverse_proxy frontend:80
    }

    log {
        output stdout
        format console
    }
}
